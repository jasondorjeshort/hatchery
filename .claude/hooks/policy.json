{
  "$comment": "Project policy for the hooks in this directory. Schema, defaults and fail modes: docs/hatchery/decisions/0006-hook-policy-file.md. Check with: node .claude/hooks/policy.js",
  "git": {
    "commit": { "subagents": ["runner"], "protectedBranches": [] },
    "push": { "subagents": ["pusher"], "branches": ["*"], "mainSession": true, "forceWithLease": [] },
    "branchDelete": { "branches": [], "requireMergedPr": false },
    "hooksPath": ".claude/hooks/git"
  },
  "usage": {
    "hold": 50, "deny": null, "staleSeconds": 7200, "whenStale": "allow",
    "sevenDay": { "hold": 97 },
    "pool": { "command": ["cswap", "list", "--json"], "timeoutSeconds": 15 }
  },
  "edit": {
    "capExempt": [],
    "anchorExempt": ["docs/design/proposals/*", "docs/design/decisions/*", "docs/findings/*", "docs/hatchery/*"],
    "formatters": {}
  },
  "privacy": {
    "identities": [{ "name": "Jason Dorje Short", "email": "jdorje@gmail.com" }]
  }
}
